<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <RootNamespace>Nif_Explorer</RootNamespace>
    <AssemblyName>NifExplorer</AssemblyName>
    <Product>Fast and High Quality Nif Explorer</Product>
    <AssemblyTitle>Fast and High Quality Nif Explorer</AssemblyTitle>
    <Description>NIF viewer and exporter for Fallout 4 and Skyrim SE.</Description>
    <StartupObject>Nif_Explorer.Program</StartupObject>
    <Configurations>Debug;Release;Publish</Configurations>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishSelfContained>false</PublishSelfContained>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- x64 SOLO, a diferencia de WM que ofrece x86: el wrapper nativo de DirectXTex que decodifica
         los DDS se linkea por plataforma, y este visor no tiene ningun motivo para existir en 32 bits. -->
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="FO4_Base_Library" />
  </ItemGroup>

  <ItemGroup>
    <!-- FO4_Base_Library trae transitivamente MaterialLib, OpenTK y el wrapper nativo. NiflySharp y
         Ba2_Bsa_Library se referencian DIRECTO porque este proyecto nombra sus tipos: INiShape /
         NiNode para las shapes, y BethesdaReader para leer los BA2/BSA que el usuario monta. -->
    <ProjectReference Include="..\FO4_Base_Library\FO4_Base_Library.vbproj" />
    <ProjectReference Include="..\NiflySharp\NiflySharp\NiflySharp.csproj" />
    <ProjectReference Include="..\Ba2_Bsa_Library\BSA_BA2_Library_DLL.vbproj" />
  </ItemGroup>

  <!-- Fija la plataforma del wrapper NATIVO. Mismo import que los otros cinco proyectos: el SDK
       inyecta el ProjectReference transitivo sin la metadata de plataforma. -->
  <Import Project="..\..\DirectXTextWrapper\DirectXTexWrapper.targets" />

  <!-- La configuración Publish: es Release con carpeta propia, y es de DONDE COPIA el CopyPublish.bat
       del mod. Sin este import compilaría SIN optimizar y en verde — ver el archivo, que lo mide. -->
  <Import Project="..\FO4_Base_Library\ConfiguracionPublish.targets" />


  <!-- Licencias. GPL-3 §4/§5 exige que el texto acompañe al binario, y MIT/Apache-2.0 exigen que
       viaje el aviso de cada componente. Se copian al output para que el paquete salga completo:
       CopyPublish.bat las toma de ahí y CORTA si falta alguna. Ver THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <Content Include="LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSE_CREDITS.txt" Link="LICENSE_CREDITS.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Explicitas, NO un wildcard: `licenses\*.txt` no puede fallar, y un paquete sin los
         textos se distribuiria en infraccion en verde. Un Content que apunta a un archivo
         inexistente da MSB3030 y pone el build en ROJO. Si se agrega una familia de licencia
         nueva, va aca Y en el for de CopyPublish.bat. -->
    <Content Include="licenses\MIT.txt" Link="licenses\MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\Apache-2.0.txt" Link="licenses\Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\MPL-2.0.txt" Link="licenses\MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="licenses\GLFW-zlib.txt" Link="licenses\GLFW-zlib.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- ⛔ LINKEADO, NO REFERENCIADO, igual que CrashReport y por un motivo todavia mas fuerte: uno de los
       dos modos de falla que VersionGate detecta es que FO4_Base_Library.dll NO CARGUE (MEDIDO: con una lib
       de version MENOR que la que este exe pide, el primer uso tira FileNotFoundException). Un chequeo que
       viviera adentro de la libreria se caeria junto con ella. Ver Shared\VersionGate.vb. -->
  <ItemGroup>
    <Compile Include="..\FO4_Base_Library\Shared\VersionGate.vb" Link="VersionGate.vb" />
  </ItemGroup>

</Project>
